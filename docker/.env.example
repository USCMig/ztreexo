# Copy to docker/.env and edit. All values below are the compose defaults.

# Pin the validator build. Bumping this mid-baseline invalidates every
# comparison in docs/benchmarks.md — re-run Phase 0 if you change it.
ZEBRA_VERSION=6.3.0

# Where the chain state lives on the host. Budget ~500 GB and growing; put it
# on the fastest disk you have, ideally NVMe. This is the path you pass to
# scripts/measure_baseline.sh --state-dir.
# ZEBRA_STATE_DIR=/home/blocknodes/.local/share/ztreexo/zebra

# Host user the container runs as, so the state dir stays host-readable.
ZEBRA_UID=1000
ZEBRA_GID=1000

# Host ports. RPC and health are pinned to 127.0.0.1 in docker-compose.yml.
ZEBRA_RPC_PORT=8232
ZEBRA_HEALTH_PORT=8080
ZEBRA_P2P_PORT=8233

# Interface for the P2P listener. 0.0.0.0 accepts inbound peers, which makes
# IBD faster and steadier. Set to 127.0.0.1 for outbound-only.
ZEBRA_P2P_BIND=0.0.0.0
